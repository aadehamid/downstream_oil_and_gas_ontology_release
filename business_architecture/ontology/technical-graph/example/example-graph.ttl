        <urn:kpi-store-example:tech:object/ontology_definitions.executive_summary_definitions_vw>,
        <urn:kpi-store-example:tech:object/ontology_definitions.measure_definitions_vw>,
        <urn:kpi-store-example:tech:object/semantic_sem_commercial.mips_mpr_benchmark_prices_fact_vw>,
        <urn:kpi-store-example:tech:object/semantic_sem_commercial.mips_mpr_executive_summary_fact_vw>,
        <urn:kpi-store-example:tech:object/semantic_sem_commercial.mpr_mips_crack_spread_price_fact_metrics_vw>,
        <urn:kpi-store-example:tech:object/silver_mdm_core.mips_price_assessment_group_dim>,
        <urn:kpi-store-example:tech:object/silver_mdm_core.mips_price_batch_dim>,
        <urn:kpi-store-example:tech:object/silver_mdm_core.mips_price_group_dim>,

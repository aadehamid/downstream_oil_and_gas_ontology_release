# The settings sync_stores.py, empty_stores.py and logical_models.py read (sync_stores.settings).
# Copy this file outside the repository, fill it in, and name the copy in EPM_STORES_ENV.
# A value set in the process environment wins over the file. Never commit a filled copy.

# The Neo4j database to read or write, over Bolt.
# NEO4J_URI=bolt://<host>:<port>
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<password>
# Leave NEO4J_DATABASE out to use the server's default database.
# NEO4J_DATABASE=<database>

# The Jena dataset's SPARQL query URL. Its data and update URLs sit beside it.
# EPM_JENA_QUERY=http://<host>:<port>/<dataset>/query

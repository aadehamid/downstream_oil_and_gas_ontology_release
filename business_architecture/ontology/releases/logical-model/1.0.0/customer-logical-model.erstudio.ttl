:mdm_core_TMR_Customer_Dim rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :mdm_core_TMR_Customer_Dim_Customer_Id ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string
] .

:mdm_core_TMR_Customer_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_TMR_Customer_Dim ;
    sh:property [
        sh:path :mdm_core_TMR_Customer_Dim_Customer_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Customer_Id must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_TMR_Customer_Dim ;
             :mdm_core_TMR_Customer_Dim_Customer_Id ?v0 .
        }
        GROUP BY ?v0 HAVING (?c > 1)
      }
      ?this a :mdm_core_TMR_Customer_Dim ;
            :mdm_core_TMR_Customer_Dim_Customer_Id ?v0 .
    }''' ;
    ] .

# Entity: Brand_Credit_Card_Dealer_Master_Xref
:mdm_core_Brand_Credit_Card_Dealer_Master_Xref a owl:Class ;
    rdfs:label "Brand_Credit_Card_Dealer_Master_Xref" ;
    dcterms:identifier "11" ;
    dcterms:description """This table serves as a cross-reference bridging dealer master, hierarchy, and class IDs.It links dealers to various organizational layers and specialized relationship types (like jobber, seller, subjobber).MID support integration with external payment or network systems.An override indicator allows exceptions from the default hierarchy structure for unique scenarios.Overall, it ensures accurate, flexible mapping and synchronization across the dealer ecosystem.""" ;
    :externalTermLinkMissing true .


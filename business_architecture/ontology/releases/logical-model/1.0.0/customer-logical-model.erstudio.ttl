# Entity: SAP_Business_Partner_Attributes_Dim
:mdm_core_SAP_Business_Partner_Attributes_Dim a owl:Class ;
    rdfs:label "SAP_Business_Partner_Attributes_Dim" ;
    dcterms:identifier "36" ;
    dcterms:description """This table stores supplemental commercial attributes, financial profiles, and operational governance indicators for customer and counterparty business partners sourced from SAP. It captures key risk-management and credit-scoring parameters, such as net income, company capitalization records, and critical regulatory/status indicators (including VIP status, calendar rules, and undesirable customer flags). Downstream, it enforces compliance and order-processing rules across core sales-area partner functions (Sold-to, Ship-to, Bill-to, and Payer) to restrict or prioritize financial transactions and credit limits before ledger settlement.""" ;
    :externalTermLinkMissing true .


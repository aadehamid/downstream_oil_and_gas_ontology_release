# Entity: CBS_Customer_User_Field_Detail_Dim
:mdm_core_CBS_Customer_User_Field_Detail_Dim a owl:Class ;
    rdfs:label "CBS_Customer_User_Field_Detail_Dim" ;
    dcterms:identifier "34" ;
    dcterms:description """This table tracks audit logs and temporal changes for custom, user-defined customer attributes within the Terminal Automation System (TAS). It captures polymorphic data values (string, float, integer, and timestamp formats) linked to specific supplier and customer number pairs, recording who modified the record and when. Downstream, it provides the historical traceability needed to audit facility-specific customer configurations and operational parameters governing bulk liquid transfers across truck bays, pipelines, and barges.""" ;
    :externalTermLinkMissing true .


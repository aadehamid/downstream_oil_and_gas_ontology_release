# Entity: Kittyhawk_Customer_Portal_Access_Dim
:mdm_core_Kittyhawk_Customer_Portal_Access_Dim a owl:Class ;
    rdfs:label "Kittyhawk_Customer_Portal_Access_Dim" ;
    dcterms:identifier "28" ;
    dcterms:description """This table manages digital portal authorization and identity mappings for commercial counterparties within Kittyhawk. It links external business associate identifiers with internal counterparty profiles to grant, control, and audit access permissions across designated customer-facing portals. Downstream, it ensures that trading partners and customers can securely view, verify, and reconcile their specific hydrocarbon deals, transfers, orders, and physical movement movements.""" ;
    :externalTermLinkMissing true .


:mdm_core_SAP_Business_Partner_Relationships_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_SAP_Business_Partner_Relationships_Dim ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Relationships_Dim_Client_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Relationships_Dim_Business_Partner1_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Relationships_Dim_Business_Partner2_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Client_Id + Business_Partner1_Number + Business_Partner2_Number must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 ?v1 ?v2 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_SAP_Business_Partner_Relationships_Dim ;
             :mdm_core_SAP_Business_Partner_Relationships_Dim_Client_Id ?v0 ;
             :mdm_core_SAP_Business_Partner_Relationships_Dim_Business_Partner1_Number ?v1 ;
             :mdm_core_SAP_Business_Partner_Relationships_Dim_Business_Partner2_Number ?v2 .
        }
        GROUP BY ?v0 ?v1 ?v2 HAVING (?c > 1)
      }
      ?this a :mdm_core_SAP_Business_Partner_Relationships_Dim ;
            :mdm_core_SAP_Business_Partner_Relationships_Dim_Client_Id ?v0 ;
            :mdm_core_SAP_Business_Partner_Relationships_Dim_Business_Partner1_Number ?v1 ;
            :mdm_core_SAP_Business_Partner_Relationships_Dim_Business_Partner2_Number ?v2 .
    }''' ;
    ] .

# Entity: SAP_Business_Partner_Identification_Numbers_Dim
:mdm_core_SAP_Business_Partner_Identification_Numbers_Dim a owl:Class ;
    rdfs:label "SAP_Business_Partner_Identification_Numbers_Dim" ;
    dcterms:identifier "54" ;
    dcterms:description """This table stores official registration keys, regulatory tax IDs, and commercial identification credentials for business partners managed in SAP. It tracks crucial compliance identifiers alongside their geographic jurisdictions (country and region), issuing institutions, and temporal validity ranges. It establishes the baseline reference data required to authenticate business partners against national trade registries and statutory regulatory frameworks. Downstream, it enforces corporate legal compliance, supports cross-border financial audits, and drives localized tax matrix calculations before transaction settlement.""" ;
    :externalTermLinkMissing true .


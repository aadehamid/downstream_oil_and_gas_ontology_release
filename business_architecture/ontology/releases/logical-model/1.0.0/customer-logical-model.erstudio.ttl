:mdm_core_CBS_Terminal_Customer_Dim rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :mdm_core_CBS_Terminal_Customer_Dim_Terminal_Id ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string
] .

:mdm_core_CBS_Terminal_Customer_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_CBS_Terminal_Customer_Dim ;
    sh:property [
        sh:path :mdm_core_CBS_Terminal_Customer_Dim_Terminal_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Terminal_Id must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_CBS_Terminal_Customer_Dim ;
             :mdm_core_CBS_Terminal_Customer_Dim_Terminal_Id ?v0 .
        }
        GROUP BY ?v0 HAVING (?c > 1)
      }
      ?this a :mdm_core_CBS_Terminal_Customer_Dim ;
            :mdm_core_CBS_Terminal_Customer_Dim_Terminal_Id ?v0 .
    }''' ;
    ] .


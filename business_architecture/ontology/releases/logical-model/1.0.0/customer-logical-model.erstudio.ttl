# Entity: SAP_Business_Partner_Role_Dim
:mdm_core_SAP_Business_Partner_Role_Dim a owl:Class ;
    rdfs:label "SAP_Business_Partner_Role_Dim" ;
    dcterms:identifier "22" ;
    dcterms:description """This table stores functional role classifications, authorization restrictions, and temporal validity ranges for customer and counterparty business partners managed in SAP. It maps business partners to specific organizational profiles (such as Sold-to, Ship-to, Bill-to, or Payer roles) and enforces access controls via authorization group codes. Downstream, it governs transactional processing and financial workflows by verifying that a business partner possesses an active and authorized role profile before allowing order execution, tax calculation, or accounting settlement within the central financial ledger.""" ;
    :externalTermLinkMissing true .


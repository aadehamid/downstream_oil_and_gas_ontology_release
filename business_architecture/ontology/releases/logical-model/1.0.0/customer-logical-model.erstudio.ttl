:udm_core_MCS_Cogeneral_Dim rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :udm_core_MCS_Cogeneral_Dim_Cogeneral_Id ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string
] .

:udm_core_MCS_Cogeneral_Dim_PK a sh:NodeShape ;
    sh:targetClass :udm_core_MCS_Cogeneral_Dim ;
    sh:property [
        sh:path :udm_core_MCS_Cogeneral_Dim_Cogeneral_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Cogeneral_Id must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :udm_core_MCS_Cogeneral_Dim ;
             :udm_core_MCS_Cogeneral_Dim_Cogeneral_Id ?v0 .
        }
        GROUP BY ?v0 HAVING (?c > 1)
      }
      ?this a :udm_core_MCS_Cogeneral_Dim ;
            :udm_core_MCS_Cogeneral_Dim_Cogeneral_Id ?v0 .
    }''' ;
    ] .

# Entity: MSMIS_Customers_Dim
:mdm_core_MSMIS_Customers_Dim a owl:Class ;
    rdfs:label "MSMIS_Customers_Dim" ;
    dcterms:identifier "4" ;
    dcterms:description """This table stores master contact details and point-of-contact profiles for customer entities operating within marine terminal and wholesale environments. It maintains primary communication channels (including emails, phone numbers, and designated representative roles) sourced from the MSMIS System. Downstream, it supports regulatory safety compliance communications during marine vessel transfers and facilitates customer relationship tracking for high-volume wholesale accounts""" ;
    :externalTermLinkMissing true .


:mdm_core_SAP_Business_Address_Services_Fax_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_SAP_Business_Address_Services_Fax_Dim ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Fax_Dim_Client_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Fax_Dim_Address_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Fax_Dim_Person_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Fax_Dim_From_Date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Fax_Dim_Sequence_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Client_Id + Address_Number + Person_Number + From_Date + Sequence_Number must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 ?v1 ?v2 ?v3 ?v4 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_SAP_Business_Address_Services_Fax_Dim ;
             :mdm_core_SAP_Business_Address_Services_Fax_Dim_Client_Id ?v0 ;
             :mdm_core_SAP_Business_Address_Services_Fax_Dim_Address_Number ?v1 ;
             :mdm_core_SAP_Business_Address_Services_Fax_Dim_Person_Number ?v2 ;
             :mdm_core_SAP_Business_Address_Services_Fax_Dim_From_Date ?v3 ;
             :mdm_core_SAP_Business_Address_Services_Fax_Dim_Sequence_Number ?v4 .
        }
        GROUP BY ?v0 ?v1 ?v2 ?v3 ?v4 HAVING (?c > 1)
      }
      ?this a :mdm_core_SAP_Business_Address_Services_Fax_Dim ;
            :mdm_core_SAP_Business_Address_Services_Fax_Dim_Client_Id ?v0 ;
            :mdm_core_SAP_Business_Address_Services_Fax_Dim_Address_Number ?v1 ;
            :mdm_core_SAP_Business_Address_Services_Fax_Dim_Person_Number ?v2 ;
            :mdm_core_SAP_Business_Address_Services_Fax_Dim_From_Date ?v3 ;
            :mdm_core_SAP_Business_Address_Services_Fax_Dim_Sequence_Number ?v4 .
    }''' ;
    ] .

# Entity: SAP_Business_Address_Services_Dim
:mdm_core_SAP_Business_Address_Services_Dim a owl:Class ;
    rdfs:label "SAP_Business_Address_Services_Dim" ;
    dcterms:identifier "40" ;
    dcterms:description """This table serves as the master repository for physical, postal, and multi-channel communication address profiles managed within SAP's Business Address Services (BAS). It captures comprehensive geographic and delivery metadata, including structural street details, house numbers, PO Box configurations, postal codes, and regional jurisdictions , alongside global identifiers and validation status codes. Downstream, it provides the authoritative, standardized address foundation required to calculate complex tax matrices, optimize freight routing, and execute accurate physical and digital distribution across core sales-area partner functions (Sold-to, Ship-to, Bill-to, and Payer).""" ;
    :externalTermLinkMissing true .


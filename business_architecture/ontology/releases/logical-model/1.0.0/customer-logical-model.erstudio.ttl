:mdm_core_Allocation_Manager_Customer_Accounts_Dim rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :mdm_core_Allocation_Manager_Customer_Accounts_Dim_Customer_Accounts_Id ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string
] .

:mdm_core_Allocation_Manager_Customer_Accounts_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_Allocation_Manager_Customer_Accounts_Dim ;
    sh:property [
        sh:path :mdm_core_Allocation_Manager_Customer_Accounts_Dim_Customer_Accounts_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Customer_Accounts_Id must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_Allocation_Manager_Customer_Accounts_Dim ;
             :mdm_core_Allocation_Manager_Customer_Accounts_Dim_Customer_Accounts_Id ?v0 .
        }
        GROUP BY ?v0 HAVING (?c > 1)
      }
      ?this a :mdm_core_Allocation_Manager_Customer_Accounts_Dim ;
            :mdm_core_Allocation_Manager_Customer_Accounts_Dim_Customer_Accounts_Id ?v0 .
    }''' ;
    ] .

# Entity: MCS_Cogeneral_Dim
:udm_core_MCS_Cogeneral_Dim a owl:Class ;
    rdfs:label "MCS_Cogeneral_Dim" ;
    dcterms:identifier "3" ;
    dcterms:description """This table stores master contact details and point-of-contact profiles for customer entities operating within marine terminal and wholesale environments. It maintains primary communication channels (including emails, phone numbers, and designated representative roles) sourced from the MSMIS System. Downstream, it supports regulatory safety compliance communications during marine vessel transfers and facilitates customer relationship tracking for high-volume wholesale accounts""" ;
    :externalTermLinkMissing true .


:mdm_core_SAP_Customer_Company_Code_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_SAP_Customer_Company_Code_Dim ;
    sh:property [
        sh:path :mdm_core_SAP_Customer_Company_Code_Dim_Client_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Customer_Company_Code_Dim_Customer_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Customer_Company_Code_Dim_Company_Code ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Client_Id + Customer_Number + Company_Code must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 ?v1 ?v2 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_SAP_Customer_Company_Code_Dim ;
             :mdm_core_SAP_Customer_Company_Code_Dim_Client_Id ?v0 ;
             :mdm_core_SAP_Customer_Company_Code_Dim_Customer_Number ?v1 ;
             :mdm_core_SAP_Customer_Company_Code_Dim_Company_Code ?v2 .
        }
        GROUP BY ?v0 ?v1 ?v2 HAVING (?c > 1)
      }
      ?this a :mdm_core_SAP_Customer_Company_Code_Dim ;
            :mdm_core_SAP_Customer_Company_Code_Dim_Client_Id ?v0 ;
            :mdm_core_SAP_Customer_Company_Code_Dim_Customer_Number ?v1 ;
            :mdm_core_SAP_Customer_Company_Code_Dim_Company_Code ?v2 .
    }''' ;
    ] .

# Entity: SAP_Customer_Sales_Area_Dim
:mdm_core_SAP_Customer_Sales_Area_Dim a owl:Class ;
    rdfs:label "SAP_Customer_Sales_Area_Dim" ;
    dcterms:identifier "24" ;
    dcterms:description """This table stores commercial, billing, shipping, and pricing configurations that govern customer transactions within a specific SAP Sales Area (defined by Sales Organization, Distribution Channel, and Division). It captures critical order execution controls such as shipping conditions, partial delivery allowances, delivery priorities, and Incoterms alongside financial configurations like customer pricing procedures, payment guarantee workflows, credit control areas, and account assignment groups. Downstream, it provides the core operational metadata required to calculate transactional pricing, enforce delivery scheduling rules, and authorize invoice generation across primary sales-area partner functions (Sold-to, Ship-to, Bill-to, and Payer).""" ;
    :externalTermLinkMissing true .


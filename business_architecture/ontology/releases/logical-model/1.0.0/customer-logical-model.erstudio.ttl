:mdm_core_SAP_Customer_Sales_Area_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_SAP_Customer_Sales_Area_Dim ;
    sh:property [
        sh:path :mdm_core_SAP_Customer_Sales_Area_Dim_Client_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Customer_Sales_Area_Dim_Customer_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Customer_Sales_Area_Dim_Sales_Organization_Short_Code ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Customer_Sales_Area_Dim_Distribution_Channel_Short_Code ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Customer_Sales_Area_Dim_Division_Short_Code ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Client_Id + Customer_Number + Sales_Organization_Short_Code + Distribution_Channel_Short_Code + Division_Short_Code must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 ?v1 ?v2 ?v3 ?v4 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_SAP_Customer_Sales_Area_Dim ;
             :mdm_core_SAP_Customer_Sales_Area_Dim_Client_Id ?v0 ;
             :mdm_core_SAP_Customer_Sales_Area_Dim_Customer_Number ?v1 ;
             :mdm_core_SAP_Customer_Sales_Area_Dim_Sales_Organization_Short_Code ?v2 ;
             :mdm_core_SAP_Customer_Sales_Area_Dim_Distribution_Channel_Short_Code ?v3 ;
             :mdm_core_SAP_Customer_Sales_Area_Dim_Division_Short_Code ?v4 .
        }
        GROUP BY ?v0 ?v1 ?v2 ?v3 ?v4 HAVING (?c > 1)
      }
      ?this a :mdm_core_SAP_Customer_Sales_Area_Dim ;
            :mdm_core_SAP_Customer_Sales_Area_Dim_Client_Id ?v0 ;
            :mdm_core_SAP_Customer_Sales_Area_Dim_Customer_Number ?v1 ;
            :mdm_core_SAP_Customer_Sales_Area_Dim_Sales_Organization_Short_Code ?v2 ;
            :mdm_core_SAP_Customer_Sales_Area_Dim_Distribution_Channel_Short_Code ?v3 ;
            :mdm_core_SAP_Customer_Sales_Area_Dim_Division_Short_Code ?v4 .
    }''' ;
    ] .

# Entity: SAP_Customer_Dim
:mdm_core_SAP_Customer_Dim a owl:Class ;
    rdfs:label "SAP_Customer_Dim" ;
    dcterms:identifier "25" ;
    dcterms:description """This table stores the master profiles, regulatory compliance parameters, tax classifications, and structural packaging rules for customer entities managed in SAP. It serves as a central customer registry containing critical physical logistics controls (such as stacking height limits, packaging material standards, and unloading point indicators), statutory tax metadata (including VAT numbers, PAN records, and local sales tax registrations), and global identifiers (such as DUNS numbers). Downstream, it provides the core customer master data to enforce corporate compliance filters (like national security and biochemical warfare blocks) and govern order-execution policies across primary sales-area partner functions (Sold-to, Ship-to, Bill-to, and Payer) prior to billing and ledger settlement.""" ;
    :externalTermLinkMissing true .


:mdm_core_Brand_Credit_Card_Dealer_Class_Dim rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :mdm_core_Brand_Credit_Card_Dealer_Class_Dim_Dealer_Class_Id ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string
] .

:mdm_core_Brand_Credit_Card_Dealer_Class_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_Brand_Credit_Card_Dealer_Class_Dim ;
    sh:property [
        sh:path :mdm_core_Brand_Credit_Card_Dealer_Class_Dim_Dealer_Class_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Dealer_Class_Id must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_Brand_Credit_Card_Dealer_Class_Dim ;
             :mdm_core_Brand_Credit_Card_Dealer_Class_Dim_Dealer_Class_Id ?v0 .
        }
        GROUP BY ?v0 HAVING (?c > 1)
      }
      ?this a :mdm_core_Brand_Credit_Card_Dealer_Class_Dim ;
            :mdm_core_Brand_Credit_Card_Dealer_Class_Dim_Dealer_Class_Id ?v0 .
    }''' ;
    ] .

# Entity: Brand_Credit_Card_Dealer_Master_Dim
:mdm_core_Brand_Credit_Card_Dealer_Master_Dim a owl:Class ;
    rdfs:label "Brand_Credit_Card_Dealer_Master_Dim" ;
    dcterms:identifier "16" ;
    dcterms:description """This table serves as the central registry for all dealers, bringing together key identifiers, classifications, operational details, and network affiliations within the brand credit card program. It tracks essential attributes such as business type, status, acquisition codes, associated dealer and jobber relationships, and financial or billing numbers, providing a 360-degree view of each dealer. The table covers business lifecycle information-from enrollment and operational open/close dates to contract, pay, and status indicators-facilitating compliance, reporting, and management activities. It manages links to discount plans, network assignments, and tax or SAP details to support seamless integration with finance, sales, and enterprise systems.""" ;
    :externalTermLinkMissing true .


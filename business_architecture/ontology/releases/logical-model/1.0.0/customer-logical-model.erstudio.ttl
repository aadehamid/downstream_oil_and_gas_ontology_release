:mdm_core_Brand_Credit_Card_Dealer_Master_Dim rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :mdm_core_Brand_Credit_Card_Dealer_Master_Dim_Dealer_Master_Id ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string
] .

:mdm_core_Brand_Credit_Card_Dealer_Master_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_Brand_Credit_Card_Dealer_Master_Dim ;
    sh:property [
        sh:path :mdm_core_Brand_Credit_Card_Dealer_Master_Dim_Dealer_Master_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Dealer_Master_Id must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_Brand_Credit_Card_Dealer_Master_Dim ;
             :mdm_core_Brand_Credit_Card_Dealer_Master_Dim_Dealer_Master_Id ?v0 .
        }
        GROUP BY ?v0 HAVING (?c > 1)
      }
      ?this a :mdm_core_Brand_Credit_Card_Dealer_Master_Dim ;
            :mdm_core_Brand_Credit_Card_Dealer_Master_Dim_Dealer_Master_Id ?v0 .
    }''' ;
    ] .

# Entity: Sap_Business_Partner_General_Data_Dim
:mdm_core_Sap_Business_Partner_General_Data_Dim a owl:Class ;
    rdfs:label "Sap_Business_Partner_General_Data_Dim" ;
    dcterms:identifier "17" ;
    dcterms:description """This table stores centralized, system-wide master data for all customer entities and counterparties sourced from SAP. It captures foundational party characteristics across persons, organizations, and groups, including legal entity structures, personal demographics, central blocking flags, and record validity timeframes. Downstream, it establishes the golden record foundation needed to underpin core sales-area partner functions (Sold-to, Ship-to, Bill-to, and Payer) for credit limit governance, tax matrix determination, and financial settlement.""" ;
    :externalTermLinkMissing true .


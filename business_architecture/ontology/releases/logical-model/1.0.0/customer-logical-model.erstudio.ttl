# Entity: CBS_Route_Customer_Dim
:mdm_core_CBS_Route_Customer_Dim a owl:Class ;
    rdfs:label "CBS_Route_Customer_Dim" ;
    dcterms:identifier "33" ;
    dcterms:description """This table stores customer-specific routing permissions and restriction rules across operational divisions and physical facilities within the Terminal Automation System (TAS). It maps supplier and customer identifiers to designated terminal and routing IDs, maintaining operational flags that determine whether a specific physical route is permitted or restricted. Downstream, it enforces gate-level and loading-bay authorization to prevent unauthorized physical hydrocarbon movements across truck bays, pipeline transfers, and barge logistics.""" ;
    :externalTermLinkMissing true .


:mdm_core_Sap_Business_Partner_General_Data_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_Sap_Business_Partner_General_Data_Dim ;
    sh:property [
        sh:path :mdm_core_Sap_Business_Partner_General_Data_Dim_Business_Partner_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_Sap_Business_Partner_General_Data_Dim_Client_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Business_Partner_Number + Client_Id must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 ?v1 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_Sap_Business_Partner_General_Data_Dim ;
             :mdm_core_Sap_Business_Partner_General_Data_Dim_Business_Partner_Number ?v0 ;
             :mdm_core_Sap_Business_Partner_General_Data_Dim_Client_Id ?v1 .
        }
        GROUP BY ?v0 ?v1 HAVING (?c > 1)
      }
      ?this a :mdm_core_Sap_Business_Partner_General_Data_Dim ;
            :mdm_core_Sap_Business_Partner_General_Data_Dim_Business_Partner_Number ?v0 ;
            :mdm_core_Sap_Business_Partner_General_Data_Dim_Client_Id ?v1 .
    }''' ;
    ] .


:mdm_core_SAP_Business_Partner_Attributes_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_SAP_Business_Partner_Attributes_Dim ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Attributes_Dim_Client_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Attributes_Dim_Business_Partner_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Client_Id + Business_Partner_Number must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 ?v1 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_SAP_Business_Partner_Attributes_Dim ;
             :mdm_core_SAP_Business_Partner_Attributes_Dim_Client_Id ?v0 ;
             :mdm_core_SAP_Business_Partner_Attributes_Dim_Business_Partner_Number ?v1 .
        }
        GROUP BY ?v0 ?v1 HAVING (?c > 1)
      }
      ?this a :mdm_core_SAP_Business_Partner_Attributes_Dim ;
            :mdm_core_SAP_Business_Partner_Attributes_Dim_Client_Id ?v0 ;
            :mdm_core_SAP_Business_Partner_Attributes_Dim_Business_Partner_Number ?v1 .
    }''' ;
    ] .

# Entity: SAP_Business_Partner_Bank_Details_Dim
:mdm_core_SAP_Business_Partner_Bank_Details_Dim a owl:Class ;
    rdfs:label "SAP_Business_Partner_Bank_Details_Dim" ;
    dcterms:identifier "37" ;
    dcterms:description """This  table stores bank account profiles, payment routing coordinates, and institutional validation credentials for customer and counterparty business partners managed in SAP. It tracks crucial financial routing structures, including International Bank Account Numbers (IBAN), Bank Keys, account holder aliases, and temporal validity ranges, alongside commercial permissions like direct debit collection authorizations. Downstream, it provides the secure master data foundation required to automate accounts receivable processing, process transactional refunds, and execute financial settlements across core partner roles (Sold-to, Ship-to, Bill-to, and Payer).""" ;
    :externalTermLinkMissing true .


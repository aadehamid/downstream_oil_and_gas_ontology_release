# Entity: CBS_Terminal_Customer_History_Dim
:mdm_core_CBS_Terminal_Customer_History_Dim a owl:Class ;
    rdfs:label "CBS_Terminal_Customer_History_Dim" ;
    dcterms:identifier "32" ;
    dcterms:description """This history table manages customer relationship configurations at the individual terminal level within the Terminal Automation System (TAS). By bridging high-level commercial customer profiles to specific localized facilities, it governs terminal-specific loading permissions, credit and lockout enforcement, and Terminal Accounting and Billing System (TABS) operational routing rules""" ;
    :externalTermLinkMissing true .


:mdm_core_SAP_Customer_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_SAP_Customer_Dim ;
    sh:property [
        sh:path :mdm_core_SAP_Customer_Dim_Client_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Customer_Dim_Customer_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Client_Id + Customer_Number must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 ?v1 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_SAP_Customer_Dim ;
             :mdm_core_SAP_Customer_Dim_Client_Id ?v0 ;
             :mdm_core_SAP_Customer_Dim_Customer_Number ?v1 .
        }
        GROUP BY ?v0 ?v1 HAVING (?c > 1)
      }
      ?this a :mdm_core_SAP_Customer_Dim ;
            :mdm_core_SAP_Customer_Dim_Client_Id ?v0 ;
            :mdm_core_SAP_Customer_Dim_Customer_Number ?v1 .
    }''' ;
    ] .

# Entity: Asphalt_Customer_Dim
:mdm_core_Asphalt_Customer_Dim a owl:Class ;
    rdfs:label "Asphalt_Customer_Dim" ;
    dcterms:identifier "26" ;
    dcterms:description """This table maintains master profiles and regional indicators for public paving contractors, construction firms, and municipalities purchasing asphalt and specialty binder products. It identifies customer accounts and distinguishes geographic operating zones (e.g., Western region) to support region - specific commercial pricing models. Downstream, it provides the core customer master reference required to track project - specific binder sales and manage contract billings indexed to crude oil price markers.""" ;
    :externalTermLinkMissing true .


:mdm_core_SAP_Business_Address_Services_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_SAP_Business_Address_Services_Dim ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Dim_Client_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Dim_Address_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Dim_From_Date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Dim_Address_Version_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Dim_To_Date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Client_Id + Address_Number + From_Date + Address_Version_Id + To_Date must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 ?v1 ?v2 ?v3 ?v4 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_SAP_Business_Address_Services_Dim ;
             :mdm_core_SAP_Business_Address_Services_Dim_Client_Id ?v0 ;
             :mdm_core_SAP_Business_Address_Services_Dim_Address_Number ?v1 ;
             :mdm_core_SAP_Business_Address_Services_Dim_From_Date ?v2 ;
             :mdm_core_SAP_Business_Address_Services_Dim_Address_Version_Id ?v3 ;
             :mdm_core_SAP_Business_Address_Services_Dim_To_Date ?v4 .
        }
        GROUP BY ?v0 ?v1 ?v2 ?v3 ?v4 HAVING (?c > 1)
      }
      ?this a :mdm_core_SAP_Business_Address_Services_Dim ;
            :mdm_core_SAP_Business_Address_Services_Dim_Client_Id ?v0 ;
            :mdm_core_SAP_Business_Address_Services_Dim_Address_Number ?v1 ;
            :mdm_core_SAP_Business_Address_Services_Dim_From_Date ?v2 ;
            :mdm_core_SAP_Business_Address_Services_Dim_Address_Version_Id ?v3 ;
            :mdm_core_SAP_Business_Address_Services_Dim_To_Date ?v4 .
    }''' ;
    ] .

# Entity: SAP_Business_Partner_Relationships_Dim
:mdm_core_SAP_Business_Partner_Relationships_Dim a owl:Class ;
    rdfs:label "SAP_Business_Partner_Relationships_Dim" ;
    dcterms:identifier "53" ;
    dcterms:description """This table stores the master relationship mappings, roles, and temporal validity ranges connecting two distinct business partner entities in SAP. It defines structural hierarchies and commercial linkages, such as parent company controls, subsidiary alignments, and contact person associations. It tracks critical transactional governance flags, including standard relationship designations, relationship categories, and role definition indicators. Downstream, it enables the consolidation of credit limits, tax matrix calculations, and financial roll-ups across complex multi-entity corporate structures.""" ;
    :externalTermLinkMissing true .


:mdm_core_Brand_Credit_Card_Dealer_Contact_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_Brand_Credit_Card_Dealer_Contact_Dim ;
    sh:property [
        sh:path :mdm_core_Brand_Credit_Card_Dealer_Contact_Dim_Dealer_Contact_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Dealer_Contact_Id must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_Brand_Credit_Card_Dealer_Contact_Dim ;
             :mdm_core_Brand_Credit_Card_Dealer_Contact_Dim_Dealer_Contact_Id ?v0 .
        }
        GROUP BY ?v0 HAVING (?c > 1)
      }
      ?this a :mdm_core_Brand_Credit_Card_Dealer_Contact_Dim ;
            :mdm_core_Brand_Credit_Card_Dealer_Contact_Dim_Dealer_Contact_Id ?v0 .
    }''' ;
    ] .


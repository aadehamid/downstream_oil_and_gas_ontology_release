:mdm_core_SAP_Business_Partner_Tax_Numbers_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_SAP_Business_Partner_Tax_Numbers_Dim ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Tax_Numbers_Dim_Client_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Tax_Numbers_Dim_Business_Partner_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Tax_Numbers_Dim_Tax_Type_Code ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Client_Id + Business_Partner_Number + Tax_Type_Code must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 ?v1 ?v2 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_SAP_Business_Partner_Tax_Numbers_Dim ;
             :mdm_core_SAP_Business_Partner_Tax_Numbers_Dim_Client_Id ?v0 ;
             :mdm_core_SAP_Business_Partner_Tax_Numbers_Dim_Business_Partner_Number ?v1 ;
             :mdm_core_SAP_Business_Partner_Tax_Numbers_Dim_Tax_Type_Code ?v2 .
        }
        GROUP BY ?v0 ?v1 ?v2 HAVING (?c > 1)
      }
      ?this a :mdm_core_SAP_Business_Partner_Tax_Numbers_Dim ;
            :mdm_core_SAP_Business_Partner_Tax_Numbers_Dim_Client_Id ?v0 ;
            :mdm_core_SAP_Business_Partner_Tax_Numbers_Dim_Business_Partner_Number ?v1 ;
            :mdm_core_SAP_Business_Partner_Tax_Numbers_Dim_Tax_Type_Code ?v2 .
    }''' ;
    ] .

# Entity: SAP_Language_Keys_Dim
:mdm_core_SAP_Language_Keys_Dim a owl:Class ;
    rdfs:label "SAP_Language_Keys_Dim" ;
    dcterms:identifier "56" ;
    dcterms:description """This table stores standardized language keys, localization specifications, and translation completeness metrics for business partners in SAP. It establishes the baseline linguistic profiles required to dynamically render customer documents, system prompts, and multi-channel communications in preferred localized formats. It supports regulatory compliance by matching official company communications with the legally mandated language criteria of the business partner's operating region. Downstream, it ensures consistent customer relations and accurate localized invoice and contract delivery across primary partner functions (such as Sold-to and Ship-to).""" ;
    :externalTermLinkMissing true .


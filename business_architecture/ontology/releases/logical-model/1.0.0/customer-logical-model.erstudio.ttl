:mdm_core_CBS_Customer_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_CBS_Customer_Dim ;
    sh:property [
        sh:path :mdm_core_CBS_Customer_Dim_Customer_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_CBS_Customer_Dim_Supplier_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Customer_Id + Supplier_Id must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 ?v1 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_CBS_Customer_Dim ;
             :mdm_core_CBS_Customer_Dim_Customer_Id ?v0 ;
             :mdm_core_CBS_Customer_Dim_Supplier_Id ?v1 .
        }
        GROUP BY ?v0 ?v1 HAVING (?c > 1)
      }
      ?this a :mdm_core_CBS_Customer_Dim ;
            :mdm_core_CBS_Customer_Dim_Customer_Id ?v0 ;
            :mdm_core_CBS_Customer_Dim_Supplier_Id ?v1 .
    }''' ;
    ] .

# Entity: CBS_Terminal_Customer_Dim
:mdm_core_CBS_Terminal_Customer_Dim a owl:Class ;
    rdfs:label "CBS_Terminal_Customer_Dim" ;
    dcterms:identifier "7" ;
    dcterms:description """This table manages customer relationship configurations at the individual terminal level within the Terminal Automation System (TAS). By bridging high-level commercial customer profiles to specific localized facilities, it governs terminal-specific loading permissions, credit and lockout enforcement, and Terminal Accounting and Billing System (TABS) operational routing rules""" ;
    :externalTermLinkMissing true .


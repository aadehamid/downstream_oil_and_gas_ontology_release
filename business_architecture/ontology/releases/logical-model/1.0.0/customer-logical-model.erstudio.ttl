:mdm_core_Brand_Credit_Card_Common_Lookup_Master_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_Brand_Credit_Card_Common_Lookup_Master_Dim ;
    sh:property [
        sh:path :mdm_core_Brand_Credit_Card_Common_Lookup_Master_Dim_Common_Lookup_Master_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Common_Lookup_Master_Id must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_Brand_Credit_Card_Common_Lookup_Master_Dim ;
             :mdm_core_Brand_Credit_Card_Common_Lookup_Master_Dim_Common_Lookup_Master_Id ?v0 .
        }
        GROUP BY ?v0 HAVING (?c > 1)
      }
      ?this a :mdm_core_Brand_Credit_Card_Common_Lookup_Master_Dim ;
            :mdm_core_Brand_Credit_Card_Common_Lookup_Master_Dim_Common_Lookup_Master_Id ?v0 .
    }''' ;
    ] .

# Entity: Allocation_Manager_Customer_Accounts_Dim
:mdm_core_Allocation_Manager_Customer_Accounts_Dim a owl:Class ;
    rdfs:label "Allocation_Manager_Customer_Accounts_Dim" ;
    dcterms:identifier "2" ;
    dcterms:description """This table stores customer account registry and profile data sourced from the Allocation Manager platform. It captures critical commercial attributes including account classifications, active statuses, sales area associations, and assigned credit monitoring and territory management personnel. Downstream, it provides the core account master data required to map contractual customer entitlements to daily load controls and enforce real-time volumetric limit calculations across physical terminal locations.""" ;
    :externalTermLinkMissing true .


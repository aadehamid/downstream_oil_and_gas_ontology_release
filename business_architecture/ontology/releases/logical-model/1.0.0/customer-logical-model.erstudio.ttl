# Entity: Kittyhawk_TDL_Exchange_Customer_Dim
:mdm_core_Kittyhawk_TDL_Exchange_Customer_Dim a owl:Class ;
    rdfs:label "Kittyhawk_TDL_Exchange_Customer_Dim" ;
    dcterms:identifier "29" ;
    dcterms:description """This table captures master identity, address, and configuration attributes for swap based exchange partners sourced from the TDL system. It maintains partner identification keys, prompt behaviors (such as purchase order verification), and active status rules required during terminal loading gate authorization. Downstream, it links real-time truck and barge physical liftings captured via BOLs to the volumetric over/under-lift exchange partner ledger.""" ;
    :externalTermLinkMissing true .


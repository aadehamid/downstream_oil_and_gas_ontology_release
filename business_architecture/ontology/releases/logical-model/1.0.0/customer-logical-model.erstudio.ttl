:mdm_core_SAP_Business_Address_Services_Telephone_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_SAP_Business_Address_Services_Telephone_Dim ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Telephone_Dim_Client_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Telephone_Dim_Address_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Telephone_Dim_Person_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Telephone_Dim_From_Date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Address_Services_Telephone_Dim_Sequence_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Client_Id + Address_Number + Person_Number + From_Date + Sequence_Number must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 ?v1 ?v2 ?v3 ?v4 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_SAP_Business_Address_Services_Telephone_Dim ;
             :mdm_core_SAP_Business_Address_Services_Telephone_Dim_Client_Id ?v0 ;
             :mdm_core_SAP_Business_Address_Services_Telephone_Dim_Address_Number ?v1 ;
             :mdm_core_SAP_Business_Address_Services_Telephone_Dim_Person_Number ?v2 ;
             :mdm_core_SAP_Business_Address_Services_Telephone_Dim_From_Date ?v3 ;
             :mdm_core_SAP_Business_Address_Services_Telephone_Dim_Sequence_Number ?v4 .
        }
        GROUP BY ?v0 ?v1 ?v2 ?v3 ?v4 HAVING (?c > 1)
      }
      ?this a :mdm_core_SAP_Business_Address_Services_Telephone_Dim ;
            :mdm_core_SAP_Business_Address_Services_Telephone_Dim_Client_Id ?v0 ;
            :mdm_core_SAP_Business_Address_Services_Telephone_Dim_Address_Number ?v1 ;
            :mdm_core_SAP_Business_Address_Services_Telephone_Dim_Person_Number ?v2 ;
            :mdm_core_SAP_Business_Address_Services_Telephone_Dim_From_Date ?v3 ;
            :mdm_core_SAP_Business_Address_Services_Telephone_Dim_Sequence_Number ?v4 .
    }''' ;
    ] .

# Entity: SAP_Business_Address_Services_Fax_Dim
:mdm_core_SAP_Business_Address_Services_Fax_Dim a owl:Class ;
    rdfs:label "SAP_Business_Address_Services_Fax_Dim" ;
    dcterms:identifier "39" ;
    dcterms:description """This table stores facsimile communication profiles, sequence mappings, and routing configurations associated with business partner addresses and personnel managed within SAP's Business Address Services (BAS). It captures regional codes, extension values, fax groups, and complete fax numbers, and direct connectivity to the SAP system. Downstream, this table provides the validated contact metadata required to automate document routing, distribute transactional confirmations (such as purchase orders and invoices), and maintain compliant partner communications across core sales-area partner functions (Sold-to, Ship-to, Bill-to, and Payer).""" ;
    :externalTermLinkMissing true .


# Entity: CBS_Customer_User_Field_Detail_History_Dim
:mdm_core_CBS_Customer_User_Field_Detail_History_Dim a owl:Class ;
    rdfs:label "CBS_Customer_User_Field_Detail_History_Dim" ;
    dcterms:identifier "35" ;
    dcterms:description """This history table tracks audit logs and temporal changes for custom, user-defined customer attributes within the Terminal Automation System (TAS). It captures polymorphic data values (string, float, integer, and timestamp formats) linked to specific supplier and customer number pairs, recording who modified the record and when. Downstream, it provides the historical traceability needed to audit facility-specific customer configurations and operational parameters governing bulk liquid transfers across truck bays, pipelines, and barges.""" ;
    :externalTermLinkMissing true .


:mdm_core_SAP_Business_Partner_Identification_Numbers_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim_Client_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim_Business_Partner_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim_Identification_Type_Code ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim_Identification_Number_Short_Text ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Client_Id + Business_Partner_Number + Identification_Type_Code + Identification_Number_Short_Text must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 ?v1 ?v2 ?v3 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim ;
             :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim_Client_Id ?v0 ;
             :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim_Business_Partner_Number ?v1 ;
             :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim_Identification_Type_Code ?v2 ;
             :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim_Identification_Number_Short_Text ?v3 .
        }
        GROUP BY ?v0 ?v1 ?v2 ?v3 HAVING (?c > 1)
      }
      ?this a :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim ;
            :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim_Client_Id ?v0 ;
            :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim_Business_Partner_Number ?v1 ;
            :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim_Identification_Type_Code ?v2 ;
            :mdm_core_SAP_Business_Partner_Identification_Numbers_Dim_Identification_Number_Short_Text ?v3 .
    }''' ;
    ] .

# Entity: SAP_Business_Partner_Tax_Numbers_Dim
:mdm_core_SAP_Business_Partner_Tax_Numbers_Dim a owl:Class ;
    rdfs:label "SAP_Business_Partner_Tax_Numbers_Dim" ;
    dcterms:identifier "55" ;
    dcterms:description """This table stores official fiscal registrations, standard tax codes, and extended tax identification numbers for customer and counterparty business partners in SAP. It maps business partners to their specific regulatory tax classifications and regional tax types required to process multi-jurisdictional commerce. It provides the structured master data identifiers utilized during order entry to validate tax-exempt statuses and execute complex fiscal calculations. Downstream, it enforces commercial compliance and drives accurate tax matrix evaluation before ledger settlement and general ledger postings.""" ;
    :externalTermLinkMissing true .


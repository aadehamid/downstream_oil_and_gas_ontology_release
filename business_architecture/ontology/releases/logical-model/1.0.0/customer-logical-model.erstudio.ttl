:mdm_core_SAP_Business_Partner_Bank_Details_Dim_PK a sh:NodeShape ;
    sh:targetClass :mdm_core_SAP_Business_Partner_Bank_Details_Dim ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Bank_Details_Dim_Client_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Bank_Details_Dim_Business_Partner_Number ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :mdm_core_SAP_Business_Partner_Bank_Details_Dim_Bank_Details_Id ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    :keyType :PrimaryKey ;
    sh:message "Primary key: Client_Id + Business_Partner_Number + Bank_Details_Id must be unique per record." ;
    sh:sparql [
        sh:select '''SELECT ?this WHERE {
      { SELECT ?v0 ?v1 ?v2 (COUNT(DISTINCT ?s) AS ?c)
        WHERE {
          ?s a :mdm_core_SAP_Business_Partner_Bank_Details_Dim ;
             :mdm_core_SAP_Business_Partner_Bank_Details_Dim_Client_Id ?v0 ;
             :mdm_core_SAP_Business_Partner_Bank_Details_Dim_Business_Partner_Number ?v1 ;
             :mdm_core_SAP_Business_Partner_Bank_Details_Dim_Bank_Details_Id ?v2 .
        }
        GROUP BY ?v0 ?v1 ?v2 HAVING (?c > 1)
      }
      ?this a :mdm_core_SAP_Business_Partner_Bank_Details_Dim ;
            :mdm_core_SAP_Business_Partner_Bank_Details_Dim_Client_Id ?v0 ;
            :mdm_core_SAP_Business_Partner_Bank_Details_Dim_Business_Partner_Number ?v1 ;
            :mdm_core_SAP_Business_Partner_Bank_Details_Dim_Bank_Details_Id ?v2 .
    }''' ;
    ] .

# Entity: SAP_Business_Address_Services_Telephone_Dim
:mdm_core_SAP_Business_Address_Services_Telephone_Dim a owl:Class ;
    rdfs:label "SAP_Business_Address_Services_Telephone_Dim" ;
    dcterms:identifier "38" ;
    dcterms:description """This table stores telephone communication profiles, sequence mappings, and contact configurations associated with business partners and personnel in SAP's Business Address Services (BAS). It captures regional codes, extension values, and complete contact numbers, alongside usability indicators designating lines for mobile use, home use, SMS delivery, or standard sender routing. Downstream, it provides the validated contact metadata required to automate operational notifications, dispatch transactional alerts, and maintain compliant customer relations across sales-area partner functions (Sold-to, Ship-to, Bill-to, and Payer).""" ;
    :externalTermLinkMissing true .

:Attribute_mdm_core_SAP_Business_Address_Services_Telephone_Dim_Client_Id a :Attribute ;
    rdfs:label "Client_Id" ;
    dcterms:identifier "1719" ;
    dcterms:description """Identifier of the client (SAP organizational unit) to which the record belongs""" ;
    :externalTermLinkMissing true .


@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dp: <https://w3id.org/mpc/ontology/modules/data-product/> .
@prefix lm: <https://w3id.org/mpc/ontology/modules/logical-model/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix party: <https://w3id.org/mpc/ontology/modules/party/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shp: <https://w3id.org/mpc/ontology/modules/logical-model/shapes/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sys: <https://w3id.org/mpc/ontology/modules/system/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shp:AnnotatedEntity a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An entity describes at most one concept, class or code list, and it is one of the party module." ;
            sh:or ( [ sh:class owl:Class ] [ sh:class skos:Concept ] [ sh:class skos:ConceptScheme ] ) ;
            sh:path lm:describes ;
            sh:pattern "^https://w3id.org/mpc/ontology/modules/party/" ],
        [ sh:maxCount 1 ;
            sh:message "An entity is implemented by at most one platform table or data product of the data-product module." ;
            sh:or ( [ sh:class dp:PlatformTable ] [ sh:class dp:DataProduct ] ) ;
            sh:path lm:implementedBy ],
        [ sh:hasValue owl:Class ;
            sh:message "Only an entity of an export, an OWL class, is annotated." ;
            sh:path rdf:type ],
        [ sh:maxCount 1 ;
            sh:message "An annotated entity has one identifier from the modelling tool, which the layer is keyed on." ;
            sh:minCount 1 ;
            sh:path dcterms:identifier ],
        [ sh:class lm:LogicalModel ;
            sh:maxCount 1 ;
            sh:message "An entity belongs to exactly one logical model." ;
            sh:minCount 1 ;
            sh:path lm:inModel ],
        [ sh:maxCount 1 ;
            sh:message "An entity comes from at most one source system: a system of the system module or a customer system of the party module." ;
            sh:or ( [ sh:class sys:System ] [ sh:class party:CustomerSystem ] ) ;
            sh:path lm:sourceSystem ] ;
    sh:targetSubjectsOf lm:describes,
        lm:implementedBy,
        lm:inModel,
        lm:sourceSystem .

shp:LogicalModel a sh:NodeShape ;
    sh:property [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:message "A logical model has one title." ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:maxCount 1 ;
            sh:message "A logical model has one slug, its identifier in the build." ;
            sh:minCount 1 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass lm:LogicalModel .


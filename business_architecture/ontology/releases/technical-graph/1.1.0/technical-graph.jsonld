[
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph",
  "@type": [
   "http://www.w3.org/2002/07/owl#Ontology"
  ],
  "http://purl.org/dc/terms/description": [
   {
    "@language": "en",
    "@value": "The kinds of thing a technical graph records about a data platform as built: hosts, source databases, tables, views, metric views, pipeline steps, the jobs and pipelines that build data objects, quality checks and agents, and the links between them, among them the data object on an earlier platform that a data object replaces; each built thing points to its design in data-product, the measure it computes in kpi and the system it copies from in system. Definitions only, never the graph's records."
   }
  ],
  "http://purl.org/dc/terms/issued": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-11-11"
   }
  ],
  "http://purl.org/dc/terms/modified": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-11-11"
   }
  ],
  "http://purl.org/dc/terms/requires": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/data-product/1.2.0"
   },
   {
    "@id": "https://w3id.org/mpc/ontology/modules/kpi/1.3.0"
   },
   {
    "@id": "https://w3id.org/mpc/ontology/modules/system/1.5.0"
   }
  ],
  "http://purl.org/dc/terms/title": [
   {
    "@language": "en",
    "@value": "MPC Technical Graph Module"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionIRI": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/1.1.0"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionInfo": [
   {
    "@value": "1.1.0"
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/Agent",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "the decision of 2026-11-02, items 1 and 2 (which agent or report answers for this measure)"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "agent"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/TechnicalObject"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An AI agent or a report that answers people's questions from the data objects it is bound to."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/Builder",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "KPI-DEC-0001, decided under its delegation (the technical graph is built from the platform's builders); Databricks, Lineage system tables reference, entity_type and entity_id, last updated 2026-11-04, https://docs.databricks.com/aws/en/admin/system-tables/lineage"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "builder"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/TechnicalObject"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A technical object that the data platform runs to write data objects: a job or a pipeline, identified by the ID the platform gives it. The platform's own lineage names it as the writer. It differs from a pipeline step, which is one ordered step of the pipeline that builds the platform itself."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/CheckResults",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "the decision of 2026-11-02, item 1 (checks passed)"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "check results"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "What a quality check found when it last ran."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/check-result/differs"
   },
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/check-result/fail"
   },
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/check-result/pass"
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/DataObject",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "the decision of 2026-11-02, item 2; data-product's dp:Layer (the decision of 2026-10-25, item 8)"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "data object"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/TechnicalObject"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A table or view on the data platform, named by its full name. Its platform layer, where it has one, is a value of data-product's layer code list."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/DefinitionsView",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "the decision of 2026-11-02, item 2; the decision of 2026-10-28"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "definitions view"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/View"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A view that publishes ontology definitions, such as measure definitions, on the data platform, so that agents read the definitions beside the data."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/Host",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "the decision of 2026-11-02, item 2"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "host"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/TechnicalObject"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A machine or service that runs one or more source databases."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/Job",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "KPI-DEC-0001, decided under its delegation; Databricks, Jobs system table reference, the jobs table, last updated 2026-11-06, https://docs.databricks.com/aws/en/admin/system-tables/jobs"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "job"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/Builder"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A builder that runs a set of tasks, on a schedule or when asked."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/MetricView",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "the decision of 2026-11-02, item 2; the decision of 2026-10-28"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "metric view"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/View"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A view that computes measures, each defined once, over a table, for agents and reports to query. The measures it computes are kpi measure definitions, by IRI."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/Orchestrator",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "the decision of 2026-11-02, item 2; the decision of 2026-10-28 (one Genie agent per subject area under a supervisor agent)"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "orchestrator"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/Agent"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An agent that passes each question to the agent suited to answer it."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/Pipeline",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "KPI-DEC-0001, decided under its delegation; Databricks, Jobs system table reference, the pipelines table, last updated 2026-11-06, https://docs.databricks.com/aws/en/admin/system-tables/jobs"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "pipeline"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/Builder"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A builder that keeps a declared set of data objects up to date, and that the data platform runs as one unit."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/PipelineStep",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "the decision of 2026-11-02, item 2"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "pipeline step"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/TechnicalObject"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "One step of the pipeline that builds or loads the platform, in the order it runs."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/QualityCheck",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "the decision of 2026-11-02, items 1 and 2 (can I trust it today)"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "quality check"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/TechnicalObject"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A named test of one or more technical objects, as last run: when it ran and what it found."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/SourceDatabase",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "the decision of 2026-11-02, item 2"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "source database"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/TechnicalObject"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A database that holds an operational system's records, or a stand-in for them, which the data platform copies from."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/Table",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "the decision of 2026-11-02, item 2"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "table"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/DataObject"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A data object that stores rows."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/TechnicalObject",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "the decision of 2026-11-02, items 2 and 4; the decision of 2026-10-28"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "technical object"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A thing built or run on a data platform, or feeding it, that the technical graph records as it is: a host, a source database, a table, a view, a pipeline step, a builder, a quality check or an agent. A record of what was built, never its design: the design is in data-product."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/View",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "the decision of 2026-11-02, item 2"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "view"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/DataObject"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A data object defined by a query over other data objects, which stores no rows of its own."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/binds",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "the decision of 2026-11-02, item 1 (which agent or report answers for this measure)"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/Agent"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "binds"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/DataObject"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A data object the agent is bound to and answers from."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/builtBy",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "KPI-DEC-0001, decided under its delegation (the technical graph is built from the platform's builders); Databricks, Lineage system tables reference, entity_type and entity_id, last updated 2026-11-04, https://docs.databricks.com/aws/en/admin/system-tables/lineage"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/DataObject"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "built by"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/Builder"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A builder that writes the data object, as the platform's lineage records it. A data object that several builders write has one link to each."
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/check-result/differs",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The check compared two accounts of the same thing, such as designed and observed lineage, and found a difference that is not on its list of known differences."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/CheckResults"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "differs"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Differs"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/CheckResults"
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/check-result/fail",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The check found a problem the platform must fix."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/CheckResults"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "fail"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Fail"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/CheckResults"
   }
  ]
 },
 {
  "@id": "https://w3id.org/mpc/ontology/modules/technical-graph/check-result/pass",
  "@type": [

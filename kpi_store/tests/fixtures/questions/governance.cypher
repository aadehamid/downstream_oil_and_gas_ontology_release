// A made-up governance graph in the shape of a governance model: servers, data systems, schemas, tables,
// columns, a report, policies and a person with a role. Every name is invented, except that the systems MIPS and
// MPR and three table names match the ontology's system codes and replica tables, so the joins return rows.
// Every node carries madeUp: true, which is how the builder knows it may replace them.
CREATE (srv:Server {serverName: 'srv-made-up-01', madeUp: true})
CREATE (mips:DataSystem {name: 'MIPS', systemId: 101, ingestionMethod: 'replication', refreshFrequency: 'daily', madeUp: true})
CREATE (mpr:DataSystem {name: 'MPR', systemId: 102, ingestionMethod: 'replication', refreshFrequency: 'daily', madeUp: true})
CREATE (zephyr:DataSystem {name: 'ZEPHYR', systemId: 103, ingestionMethod: 'file', refreshFrequency: 'weekly', madeUp: true})
CREATE (dw:DataSystem {name: 'DW_REPORTING', madeUp: true})
CREATE (srv)-[:HOSTS]->(mips), (srv)-[:HOSTS]->(mpr), (srv)-[:HOSTS]->(zephyr), (srv)-[:HOSTS]->(dw)
CREATE (s_mips:Schema {qualifiedName: 'MIPS', layer: 'Operational', role: 'source', madeUp: true})
CREATE (s_mpr:Schema {qualifiedName: 'MPR', layer: 'Operational', role: 'source', madeUp: true})
CREATE (s_zephyr:Schema {qualifiedName: 'ZEPHYR', layer: 'Operational', role: 'source', madeUp: true})
CREATE (s_rpt:Schema:Legacy {qualifiedName: 'RPT', layer: 'Reporting', role: 'reporting', madeUp: true})
CREATE (mips)-[:CONTAINS]->(s_mips), (mpr)-[:CONTAINS]->(s_mpr), (zephyr)-[:CONTAINS]->(s_zephyr), (dw)-[:CONTAINS]->(s_rpt)
CREATE (t1:Table {qualifiedName: 'MIPS.PriceAssessment', layer: 'Operational', madeUp: true})
CREATE (t2:Table {qualifiedName: 'MIPS.PriceBatch', layer: 'Operational', madeUp: true})
CREATE (t3:Table:Dimension {qualifiedName: 'MIPS.Currency', layer: 'Operational', madeUp: true})
CREATE (t4:Table {qualifiedName: 'MPR.PriceMaster', layer: 'Operational', classification: 'Confidential', madeUp: true})
CREATE (t5:Table {qualifiedName: 'MPR.PriceDetail', layer: 'Operational', classification: 'Internal', madeUp: true})
CREATE (t6:Table {qualifiedName: 'ZEPHYR.Orders', layer: 'Operational', classification: 'Confidential', madeUp: true})
CREATE (t7:Table {qualifiedName: 'ZEPHYR.OrderLines', layer: 'Operational', madeUp: true})
CREATE (t8:Table:Fact:Legacy {qualifiedName: 'RPT.PriceSummary', layer: 'Reporting', madeUp: true})
CREATE (s_mips)-[:CONTAINS]->(t1), (s_mips)-[:CONTAINS]->(t2), (s_mips)-[:CONTAINS]->(t3)
CREATE (s_mpr)-[:CONTAINS]->(t4), (s_mpr)-[:CONTAINS]->(t5)
CREATE (s_zephyr)-[:CONTAINS]->(t6), (s_zephyr)-[:CONTAINS]->(t7)
CREATE (s_rpt)-[:CONTAINS]->(t8)
CREATE (c1:Column {qualifiedName: 'MIPS.PriceAssessment.AssessmentAmount', madeUp: true})
CREATE (c2:Column {qualifiedName: 'RPT.PriceSummary.Amount', madeUp: true})
CREATE (t1)-[:HAS_COLUMN]->(c1), (t8)-[:HAS_COLUMN]->(c2)
CREATE (t8)-[:DERIVED_FROM]->(t1), (c2)-[:DERIVED_FROM]->(c1)
CREATE (r:Report {reportKey: 'report-made-up-01', madeUp: true})-[:CONSUMES]->(t8)
CREATE (p1:Policy {name: 'SOX financial reporting', madeUp: true})-[:APPLIES_TO]->(mips)
CREATE (p2:Policy {name: 'Confidential pricing data', madeUp: true})-[:APPLIES_TO]->(t1)
CREATE (p3:Policy {name: 'Seven year retention', madeUp: true})-[:APPLIES_TO]->(zephyr)
CREATE (:Person {name: 'person-made-up-01', madeUp: true})-[:HAS_ROLE]->(:RoleAssignment {type: 'steward', scope: 'MIPS', madeUp: true});
